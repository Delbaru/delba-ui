{
  "name": "@delba/ui",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "description": "Общая UI-библиотека примитивов: Flex, Grid, Text, Icon, Img, Button, Modal, Select, Input…",
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./skin": "./src/skin/index.ts",
    "./rich-text": "./src/rich-text.ts",
    "./icons/*": "./assets/icons/ui/*",
    "./next": {
      "types": "./tools/next.d.mts",
      "default": "./tools/next.mjs"
    },
    "./config": "./tools/config.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "delba-ui": "./tools/cli.mjs"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"tools/**/*.test.ts\"",
    "boundary": "node tools/check-boundary.mjs"
  },
  "dependencies": {
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "@fancyapps/ui": "^6.1.14",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "isomorphic-dompurify": "^3.13.0",
    "lenis": "^1.3.23",
    "lexical": "^0.44.0",
    "next": "^16.3.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sass": "^1.80.0",
    "swiper": "^12.1.4",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0"
  }
}
