{
  "name": "@delba/frontend",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "description": "Общая UI-библиотека примитивов: Flex, Grid, Text, Icon, Img, Button, Modal, Select, Input…",
  "sideEffects": [
    "*.scss",
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./carousel": "./src/components/NativeCarousel/index.ts",
    "./phone-field": "./src/components/PhoneField/index.ts",
    "./skin": "./src/skin/index.ts",
    "./rich-text": "./src/rich-text.ts",
    "./url": "./src/core/base/url.ts",
    "./validation": "./src/validation.ts",
    "./icons/*": "./assets/icons/*",
    "./next": {
      "types": "./tools/next.d.mts",
      "default": "./tools/next.mjs"
    },
    "./prettier": "./tools/check/prettier-plugin.mjs",
    "./verify": {
      "types": "./tools/check/verify.d.mts",
      "default": "./tools/check/verify.mjs"
    },
    "./config": "./tools/config.ts",
    "./motion": "./src/motion.ts",
    "./startup": "./src/startup.ts",
    "./package.json": "./package.json",
    "./skin/runtime": "./src/skin/runtime.tsx",
    "./skin/effects": "./src/skin/_effects.scss",
    "./module": {
      "types": "./tools/module.d.mts",
      "default": "./tools/module.mjs"
    },
    "./next-env": {
      "types": "./tools/next-env.d.mts",
      "default": "./tools/next-env.mjs"
    },
    "./theme": "./src/theme.ts",
    "./styles.scss": "./src/styles.scss",
    "./theme.css": "./src/core/theme.css",
    "./calendar": "./src/core/Calendar/Calendar.ts"
  },
  "scripts": {
    "typecheck": "node tools/check/typecheck.mjs",
    "test": "node tools/check/test.mjs",
    "boundary": "node tools/check-boundary.mjs",
    "check": "node tools/check/index.mjs"
  },
  "dependencies": {
    "libphonenumber-js": "1.13.15",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "prettier": "^3.6.2",
    "@fancyapps/ui": "^6.1.14",
    "@lexical/link": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "isomorphic-dompurify": "^3.13.0",
    "lexical": "^0.44.0",
    "next": "^16.3.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sass": "^1.80.0",
    "swiper": "^12.1.4",
    "typescript": "^5.0.0",
    "@next/env": "^16.3.3"
  },
  "peerDependenciesMeta": {
    "prettier": {
      "optional": true
    }
  },
  "devDependencies": {
    "@delba/eslint": "workspace:*",
    "prettier": "~3.6.2",
    "@types/node": "^25.6.0"
  },
  "imports": {
    "#core": "./src/core/index.ts",
    "#core/*": "./src/core/*/index.ts",
    "#ui": "./src/ui.ts",
    "#components": "./src/components/index.ts",
    "#components/*": "./src/components/*/index.ts",
    "#icons/*": "./assets/icons/*"
  }
}
